// Prisma schema — banco de leads do site Nexio.
// Postgres no Supabase (projeto Nexio-SS). DATABASE_URL usa o pooler
// (transaction, 6543); DIRECT_URL é a conexão de sessão (5432) p/ migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  name        String
  company     String?
  whatsapp    String
  projectType String // Site, Software, Sistema, App, SaaS, Automação IA, Outro
  budgetRange String? // faixa estimada
  description String
  status      String   @default("new") // new | contacted
  source      String   @default("site")

  @@index([createdAt])
}
