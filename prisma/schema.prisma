// Prisma schema — banco de leads do site Nexio.
// Dev: SQLite. Para produção (AWS RDS), trocar provider para "postgresql"
// e o DATABASE_URL — o model abaixo é portável.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  name        String
  company     String?
  whatsapp    String
  projectType String // Site, Software, Sistema, App, SaaS, Automação IA, Outro
  budgetRange String? // faixa estimada
  description String
  status      String   @default("new") // new | contacted
  source      String   @default("site")

  @@index([createdAt])
}
